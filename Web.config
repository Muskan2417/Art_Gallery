<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ArtGalleryDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=HeritageFameArtGallery;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <sessionState mode="InProc" timeout="30" />
  </system.web>
</configuration>
